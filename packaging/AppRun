#!/bin/bash
set -euo pipefail

APPDIR="$(cd "$(dirname "$0")" && pwd)"
VERSION_FILE="$APPDIR/usr/sbin/icb-sandboxd"
INSTALLED_DAEMON="/usr/sbin/icb-sandboxd"
INSTALLED_CTL="/usr/bin/icb-sandbox-ctl"
SERVICE_NAME="icb-sandboxd.service"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

info()  { printf "${CYAN}[info]${NC} %s\n" "$*"; }
ok()    { printf "${GREEN}[ok]${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}[warn]${NC} %s\n" "$*"; }
err()   { printf "${RED}[error]${NC} %s\n" "$*" >&2; }

bundled_version() {
    "$APPDIR/usr/sbin/icb-sandboxd" --version 2>/dev/null | awk '{print $2}'
}

installed_version() {
    "$INSTALLED_DAEMON" --version 2>/dev/null | awk '{print $2}'
}

check_kernel() {
    local ok=true
    if [ ! -f /sys/kernel/btf/vmlinux ]; then
        err "Kernel BTF not available (/sys/kernel/btf/vmlinux missing)"
        err "Rebuild kernel with CONFIG_DEBUG_INFO_BTF=y"
        ok=false
    fi
    if ! grep -q "bpf" /sys/kernel/security/lsm 2>/dev/null; then
        err "BPF LSM not enabled in kernel"
        err "Add lsm=bpf to kernel boot parameters"
        ok=false
    fi
    [ "$ok" = true ]
}

do_install() {
    info "Installing icb-sandbox $(bundled_version)..."

    if ! check_kernel; then
        err "Kernel requirements not met. Cannot install."
        exit 1
    fi

    if [ "$(id -u)" -ne 0 ]; then
        err "Installation requires root. Re-run with: sudo $0 install"
        exit 1
    fi

    # Ask where to install icb-agent
    local agent_path="/usr/bin/icb-agent"
    if [ -f "$APPDIR/usr/bin/icb-agent" ]; then
        printf "${CYAN}Where to install icb-agent?${NC} [%s]: " "$agent_path"
        read -r user_path
        [ -n "$user_path" ] && agent_path="$user_path"
    fi

    # Create group if not exists
    getent group icb-sandbox >/dev/null 2>&1 || groupadd icb-sandbox

    # Install sandbox binaries
    install -m 755 "$APPDIR/usr/sbin/icb-sandboxd" /usr/sbin/
    install -m 755 "$APPDIR/usr/bin/icb-sandbox-ctl" /usr/bin/
    install -m 755 "$APPDIR/usr/bin/icb-sandbox-bootstrap" /usr/bin/

    # Install icb-agent if bundled
    if [ -f "$APPDIR/usr/bin/icb-agent" ]; then
        local agent_dir
        agent_dir="$(dirname "$agent_path")"
        mkdir -p "$agent_dir"
        install -m 755 "$APPDIR/usr/bin/icb-agent" "$agent_path"
        ok "icb-agent installed to $agent_path"
    fi

    # Install BPF object
    mkdir -p /usr/lib/icb-sandbox
    install -m 644 "$APPDIR/usr/lib/icb-sandbox/bpfjailer.bpf.o" /usr/lib/icb-sandbox/

    # Generate and install policy with exec_enrollment for icb-agent
    mkdir -p /etc/icb/sandbox/policy.d
    if [ ! -f /etc/icb/sandbox/policy.toml ]; then
        cp "$APPDIR/etc/default-policy.toml" /etc/icb/sandbox/policy.toml
        # Append exec_enrollment for icb-agent so it auto-enrolls on exec
        if [ -n "$agent_path" ] && [ -f "$agent_path" ]; then
            cat >> /etc/icb/sandbox/policy.toml <<POLICY

[[exec_enrollments]]
executable_path = "$agent_path"
pod_id = 5010
role = "code_agent"
POLICY
            ok "Added exec_enrollment for $agent_path -> code_agent"
        fi
        chmod 644 /etc/icb/sandbox/policy.toml
    else
        warn "Policy already exists at /etc/icb/sandbox/policy.toml, not overwriting."
        info "To add icb-agent enrollment manually, append to policy.toml:"
        printf '  [[exec_enrollments]]\n  executable_path = "%s"\n  pod_id = 5010\n  role = "code_agent"\n' "$agent_path"
    fi

    # Install systemd units
    install -m 644 "$APPDIR/etc/icb-sandboxd.service" /etc/systemd/system/
    install -m 644 "$APPDIR/etc/icb-sandbox-bootstrap.service" /etc/systemd/system/
    systemctl daemon-reload

    # Enable and start
    systemctl enable --now icb-sandboxd.service
    ok "icb-sandbox $(bundled_version) installed and running."
    info "Add users to 'icb-sandbox' group: sudo usermod -aG icb-sandbox <user>"
}

do_upgrade() {
    local cur installed
    cur=$(bundled_version)
    installed=$(installed_version)

    if [ "$cur" = "$installed" ]; then
        ok "Already at version $cur, nothing to do."
        return 0
    fi

    info "Upgrading icb-sandbox: $installed -> $cur"
    if [ "$(id -u)" -ne 0 ]; then
        err "Upgrade requires root. Re-run with: sudo $0 upgrade"
        exit 1
    fi

    systemctl stop icb-sandboxd.service 2>/dev/null || true
    install -m 755 "$APPDIR/usr/sbin/icb-sandboxd" /usr/sbin/
    install -m 755 "$APPDIR/usr/bin/icb-sandbox-ctl" /usr/bin/
    install -m 755 "$APPDIR/usr/bin/icb-sandbox-bootstrap" /usr/bin/
    install -m 644 "$APPDIR/usr/lib/icb-sandbox/bpfjailer.bpf.o" /usr/lib/icb-sandbox/
    install -m 644 "$APPDIR/etc/icb-sandboxd.service" /etc/systemd/system/
    systemctl daemon-reload
    systemctl start icb-sandboxd.service
    ok "Upgraded to $(installed_version)."
}

do_uninstall() {
    if [ "$(id -u)" -ne 0 ]; then
        err "Uninstall requires root. Re-run with: sudo $0 uninstall"
        exit 1
    fi
    "$INSTALLED_CTL" uninstall "$@"
}

do_status() {
    if [ ! -x "$INSTALLED_DAEMON" ]; then
        warn "icb-sandbox is not installed."
        return 1
    fi
    ok "Installed: $(installed_version)"
    systemctl is-active --quiet "$SERVICE_NAME" && ok "Daemon: running" || warn "Daemon: stopped"
    local bundled
    bundled=$(bundled_version)
    if [ "$bundled" != "$(installed_version)" ]; then
        info "Update available: $bundled (run '$0 upgrade')"
    fi
}

show_help() {
    printf "${BOLD}icb-sandbox${NC} — BPF LSM kernel sandbox for icb-agent\n\n"
    printf "${BOLD}Usage:${NC} %s <command>\n\n" "$(basename "$0")"
    printf "${BOLD}Commands:${NC}\n"
    printf "  ${GREEN}install${NC}     Install daemon and CLI to system (requires sudo)\n"
    printf "  ${GREEN}upgrade${NC}     Upgrade installed binaries to bundled version\n"
    printf "  ${GREEN}uninstall${NC}   Remove icb-sandbox from system (--purge to remove config)\n"
    printf "  ${GREEN}status${NC}      Show installed version and daemon state\n"
    printf "  ${GREEN}check${NC}       Verify kernel meets requirements (no install)\n"
    printf "  ${GREEN}ctl${NC} [args]  Run icb-sandbox-ctl directly from AppImage\n"
    printf "  ${GREEN}help${NC}        Show this message\n"
    printf "\n${BOLD}Quick start:${NC}\n"
    printf "  sudo ./%s install        # install + start daemon\n" "$(basename "$0")"
    printf "  icb-sandbox-ctl doctor   # verify everything works\n"
    printf "  icb-sandbox-ctl enroll   # enroll current shell\n"
    printf "\n${BOLD}Kernel requirements:${NC}\n"
    printf "  - CONFIG_DEBUG_INFO_BTF=y (BTF type info)\n"
    printf "  - Boot param: lsm=landlock,lockdown,yama,bpf\n"
    printf "\n"
}

# --- Main dispatch ---
CMD="${1:-help}"
shift 2>/dev/null || true

case "$CMD" in
    install)   do_install "$@" ;;
    upgrade)   do_upgrade "$@" ;;
    uninstall) do_uninstall "$@" ;;
    status)    do_status "$@" ;;
    check)     check_kernel && ok "Kernel requirements met." ;;
    ctl)       exec "$APPDIR/usr/bin/icb-sandbox-ctl" "$@" ;;
    help|--help|-h) show_help ;;
    *)
        err "Unknown command: $CMD"
        show_help
        exit 1
        ;;
esac
